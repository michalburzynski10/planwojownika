# Nagłówki bezpieczeństwa dla całej witryny (Cloudflare Pages)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Uwaga: Content-Security-Policy celowo pominięte — strona ładuje zewnętrzne
# skrypty (Meta/TikTok/GA4, Google Fonts). CSP można dodać później, ostrożnie,
# z whitelistą tych domen, żeby nie zablokować pikseli.
